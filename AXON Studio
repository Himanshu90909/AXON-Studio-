.pill-current{background:rgba(91,108,249,.18);color:var(--accent)}
.pill-upcoming{background:rgba(255,255,255,.07);color:var(--fg3)}
.step-body h3{font-size:1.4rem;font-weight:800;margin-bottom:10px}
.step-body>p{color:var(--fg2);font-size:.9rem;line-height:1.75;font-weight:300;margin-bottom:20px}

.task-list{display:flex;flex-direction:column;gap:8px;margin-bottom:20px}
