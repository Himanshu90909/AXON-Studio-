.faq-item.open .faq-icon{transform:rotate(45deg);background:rgba(91,108,249,.15);border-color:rgba(91,108,249,.3);color:var(--accent)}
.faq-answer{
  max-height:0;overflow:hidden;transition:max-height .35s ease;color:var(--fg2);
  font-size:.88rem;line-height:1.78;font-weight:300;
}
.faq-item.open .faq-answer{max-height:300px;padding-bottom:20px}

