      <select class="form-select">
        <option>Web Development</option>
        <option>UI/UX Design</option>
        <option>Branding</option>
        <option>SEO &amp; Growth</option>
        <option>AI Automation</option>
        <option>Digital Marketing</option>
        <option>Multiple services</option>
      </select>
    </div>
    <div class="form-group">
      <label class="form-label">Approximate budget</label>
      <select class="form-select">
        <option>$5,000 – $15,000</option>
        <option>$15,000 – $35,000</option>
        <option>$35,000 – $75,000</option>
        <option>$75,000+</option>
      </select>
    </div>
    <div class="form-group"><label class="form-label">Tell us about your project</label><textarea class="form-textarea" placeholder="What are you building, what's the goal, and when do you need it?"></textarea></div>
    <button class="form-submit" onclick="submitForm()">Send message →</button>
  </div>
</div>

<script>
// ===== NAVIGATION =====
function navigate(page, service) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
  document.getElementById('page-' + page).classList.add('active');
  const navLink = document.querySelector('[data-page="' + page + '"]');
  if (navLink) navLink.classList.add('active');
  window.scrollTo(0, 0);
  if (page === 'services' && service) {
    setTimeout(() => showService(service), 100);
  }
  // Animate progress bars on services page
  if (page === 'services') {
    setTimeout(() => {
      document.getElementById('overallFill').style.width = '35%';
    }, 300);
  }
}

// ===== SERVICES SIDEBAR =====
function showService(id) {
  document.querySelectorAll('.srv-nav-item').forEach(n => n.classList.remove('active'));
  document.querySelectorAll('.srv-detail').forEach(d => d.classList.remove('active'));
  const navItem = document.querySelector('[data-svc="' + id + '"]');
  const detailPanel = document.querySelector('[data-detail="' + id + '"]');
  if (navItem) navItem.classList.add('active');
  if (detailPanel) detailPanel.classList.add('active');
  // Animate progress bars
  setTimeout(() => {
    detailPanel.querySelectorAll('.pr-fill').forEach(bar => {
      bar.style.width = bar.style.width;
    });
  }, 50);
}

// ===== TESTIMONIALS SLIDER =====
let testiIdx = 0;
function slideTestimonial(dir) {
  const track = document.getElementById('testiTrack');
  const cards = track.querySelectorAll('.testi-card');
  const maxIdx = cards.length - 2;
  testiIdx = Math.max(0, Math.min(testiIdx + dir, maxIdx));
  const cardW = cards[0].offsetWidth + 20;
  track.style.transform = 'translateX(-' + (testiIdx * cardW) + 'px)';
}

// ===== FAQ =====
function toggleFaq(el) {
  const item = el.parentElement;
  const isOpen = item.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(f => f.classList.remove('open'));
  if (!isOpen) item.classList.add('open');
}

// ===== WORK FILTER =====
function filterWork(btn, tag) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.work-card-main').forEach(card => {
    if (tag === 'all') {
      card.style.display = '';
    } else {
      const tags = card.getAttribute('data-tags') || '';
      card.style.display = tags.includes(tag) ? '' : 'none';
    }
  });
}

// ===== CONTACT MODAL =====
function openContact() {
  document.getElementById('contactModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeContact() {
  document.getElementById('contactModal').classList.remove('open');
  document.body.style.overflow = '';
}
function closeContactOnOverlay(e) {
  if (e.target === document.getElementById('contactModal')) closeContact();
}
function submitForm() {
  const btn = document.querySelector('.form-submit');
  btn.textContent = 'Sending…';
  setTimeout(() => {
    btn.textContent = '✓ Message sent! We\'ll be in touch within 24hrs.';
    btn.style.background = 'var(--green)';
    btn.style.color = '#000';
    setTimeout(closeContact, 2500);
  }, 1200);
}

// ===== KEYBOARD ESC =====
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeContact(); });

// ===== INIT =====
document.addEventListener('DOMContentLoaded', () => {
  showService('web');
  // Stagger hero animations
  const heroContent = document.querySelector('.hero-content');
  if (heroContent) heroContent.style.animation = 'pageIn .6s ease .1s both';
});
</script>
</body>
</html>
