<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AXON Studio — Premium Digital Agency</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
<style>
/* ===== RESET & TOKENS ===== */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#07070a;--bg2:#0f0f14;--bg3:#161620;--bg4:#1e1e2a;
  --fg:#f0ede8;--fg2:#9e9b96;--fg3:#56544f;
  --accent:#5b6cf9;--accent2:#8b5cf6;--accent3:#3b82f6;
  --green:#10d9a0;--amber:#f59e0b;--red:#f97316;
  --border:rgba(255,255,255,.07);--border2:rgba(255,255,255,.12);
  --r:10px;--r2:16px;--r3:24px;
}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
body{background:var(--bg);color:var(--fg);font-family:'DM Sans',sans-serif;min-height:100vh;overflow-x:hidden}
h1,h2,h3,h4,h5{font-family:'Syne',sans-serif;letter-spacing:-.03em}
a{text-decoration:none;color:inherit}
button{cursor:pointer;border:none;font-family:inherit}
img{display:block}
ul{list-style:none}

/* ===== SCROLLBAR ===== */
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--bg4);border-radius:2px}

/* ===== NAV ===== */
nav{
  position:fixed;top:0;left:0;right:0;z-index:1000;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 48px;height:68px;
  background:rgba(7,7,10,.8);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);
  border-bottom:1px solid var(--border);
  transition:all .3s;
}
.logo{
  display:flex;align-items:center;gap:10px;font-family:'Syne',sans-serif;
  font-weight:800;font-size:1.2rem;letter-spacing:-.02em;cursor:pointer;
}
.logo-dot{
  width:9px;height:9px;border-radius:50%;background:var(--accent);
  box-shadow:0 0 12px var(--accent);animation:blink 2.5s ease-in-out infinite;
}
@keyframes blink{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.6;transform:scale(.85)}}
.nav-center{display:flex;gap:2px}
.nav-link{
  padding:8px 16px;border-radius:8px;color:var(--fg2);font-size:.875rem;
  font-weight:500;cursor:pointer;background:none;border:none;
  transition:all .2s;font-family:'DM Sans',sans-serif;
}
.nav-link:hover{color:var(--fg);background:rgba(255,255,255,.06)}
.nav-link.active{color:var(--fg);background:rgba(255,255,255,.09)}
.nav-right{display:flex;align-items:center;gap:12px}
.nav-available{display:flex;align-items:center;gap:6px;font-size:.78rem;color:var(--green);font-weight:500}
.nav-available::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 8px var(--green)}
.nav-cta{
  padding:9px 22px;border-radius:9px;background:var(--accent);color:#fff;
  font-size:.875rem;font-weight:500;transition:all .22s;
}
.nav-cta:hover{background:#6d7efb;transform:translateY(-1px);box-shadow:0 8px 24px rgba(91,108,249,.35)}

/* ===== PAGES ===== */
.page{display:none;min-height:100vh;padding-top:68px}
.page.active{display:block;animation:pageIn .4s ease both}
@keyframes pageIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}

/* ===== UTILITIES ===== */
.container{max-width:1200px;margin:0 auto;padding:0 48px}
.section{padding:100px 48px}
.section-tag{
  display:inline-flex;align-items:center;gap:6px;
  font-size:.72rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;
  color:var(--accent);margin-bottom:14px;
}
.section-tag::before{content:'';width:16px;height:1px;background:var(--accent)}
.section-title{font-size:clamp(2rem,4vw,3.2rem);font-weight:800;line-height:1.08;margin-bottom:18px}
.section-title em{font-style:normal;background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.section-sub{color:var(--fg2);font-size:1rem;line-height:1.75;font-weight:300;max-width:520px}
.grid-row{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:52px;flex-wrap:wrap}

.btn-primary{
  display:inline-flex;align-items:center;gap:8px;
  padding:13px 26px;border-radius:10px;background:var(--accent);color:#fff;
  font-size:.925rem;font-weight:500;border:none;transition:all .25s;
}
.btn-primary:hover{background:#6d7efb;transform:translateY(-2px);box-shadow:0 12px 32px rgba(91,108,249,.38)}
.btn-secondary{
  display:inline-flex;align-items:center;gap:8px;
  padding:13px 26px;border-radius:10px;background:rgba(255,255,255,.06);color:var(--fg);
  font-size:.925rem;font-weight:500;border:1px solid var(--border2);transition:all .25s;
}
.btn-secondary:hover{background:rgba(255,255,255,.1);transform:translateY(-2px)}
.btn-ghost{
  display:inline-flex;align-items:center;gap:6px;color:var(--accent);
  font-size:.875rem;font-weight:500;background:none;border:none;
  transition:gap .2s;
}
.btn-ghost:hover{gap:10px}

/* ===== HOME — HERO ===== */
.hero{
  min-height:calc(100vh - 68px);display:flex;flex-direction:column;
  align-items:center;justify-content:center;text-align:center;
  padding:80px 48px 60px;position:relative;overflow:hidden;
}
.hero-bg{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.hero-orb{position:absolute;border-radius:50%;filter:blur(90px)}
.orb-a{width:600px;height:600px;background:rgba(91,108,249,.14);top:-150px;left:-180px;animation:orbA 9s ease-in-out infinite}
.orb-b{width:480px;height:480px;background:rgba(139,92,246,.11);bottom:-100px;right:-140px;animation:orbB 11s ease-in-out infinite}
.orb-c{width:360px;height:360px;background:rgba(16,217,160,.07);top:50%;left:50%;transform:translate(-50%,-50%);animation:orbC 7s ease-in-out infinite}
@keyframes orbA{0%,100%{transform:translate(0,0)}50%{transform:translate(50px,35px)}}
@keyframes orbB{0%,100%{transform:translate(0,0)}50%{transform:translate(-40px,-50px)}}
@keyframes orbC{0%,100%{transform:translate(-50%,-50%) scale(1)}50%{transform:translate(-50%,-50%) scale(1.12)}}
.hero-noise{
  position:absolute;inset:0;opacity:.025;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}
.hero-content{position:relative;z-index:1;max-width:860px}
.hero-badge{
  display:inline-flex;align-items:center;gap:8px;padding:7px 16px;
  border-radius:100px;border:1px solid rgba(16,217,160,.3);
  background:rgba(16,217,160,.08);color:var(--green);
  font-size:.78rem;font-weight:600;letter-spacing:.04em;margin-bottom:32px;
}
.hero-badge-dot{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 8px var(--green);animation:blink 2s infinite}
.hero h1{
  font-size:clamp(3rem,7vw,5.5rem);font-weight:800;line-height:1.03;
  letter-spacing:-.05em;margin-bottom:26px;
}
.hero-sub{
  font-size:1.15rem;color:var(--fg2);line-height:1.75;margin-bottom:44px;
  font-weight:300;max-width:580px;margin-left:auto;margin-right:auto;
}
.hero-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-bottom:72px}
.hero-social-proof{border-top:1px solid var(--border);padding-top:40px}
.trusted-label{font-size:.72rem;color:var(--fg3);letter-spacing:.12em;text-transform:uppercase;margin-bottom:20px;font-weight:600}
.trusted-logos{display:flex;gap:40px;justify-content:center;align-items:center;flex-wrap:wrap}
.trusted-logo{
  font-family:'Syne',sans-serif;font-weight:800;font-size:.95rem;
  color:var(--fg3);letter-spacing:.04em;transition:.2s;cursor:default;
}
.trusted-logo:hover{color:var(--fg2)}

/* ===== HOME — STATS BAR ===== */
.stats-bar{
  display:grid;grid-template-columns:repeat(4,1fr);
  border-top:1px solid var(--border);border-bottom:1px solid var(--border);
}
.stat-item{
  padding:36px 32px;text-align:center;border-right:1px solid var(--border);
  position:relative;overflow:hidden;transition:.3s;
}
.stat-item:last-child{border-right:none}
.stat-item::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(91,108,249,.06),transparent);
  opacity:0;transition:.3s;
}
.stat-item:hover::before{opacity:1}
.stat-num{
  font-family:'Syne',sans-serif;font-size:2.6rem;font-weight:800;line-height:1;
  margin-bottom:6px;
}
.stat-num span{color:var(--accent)}
.stat-label{font-size:.8rem;color:var(--fg3);font-weight:400}

/* ===== HOME — SERVICES PREVIEW ===== */
.services-preview-grid{
  display:grid;grid-template-columns:repeat(3,1fr);
  border:1px solid var(--border);border-radius:var(--r3);overflow:hidden;
}
.srv-card{
  padding:36px 30px;border-right:1px solid var(--border);
  border-bottom:1px solid var(--border);
  transition:all .3s;position:relative;overflow:hidden;cursor:pointer;
  background:var(--bg2);
}
.srv-card:nth-child(3n){border-right:none}
.srv-card:nth-child(n+4){border-bottom:none}
.srv-card::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(91,108,249,.07),rgba(139,92,246,.04));
  opacity:0;transition:.3s;
}
.srv-card:hover{background:var(--bg3);transform:translateY(-2px)}
.srv-card:hover::after{opacity:1}
.srv-icon{
  width:46px;height:46px;border-radius:12px;
  display:flex;align-items:center;justify-content:center;font-size:1.35rem;
  background:rgba(91,108,249,.12);border:1px solid rgba(91,108,249,.22);
  margin-bottom:22px;transition:.3s;position:relative;z-index:1;
}
.srv-card:hover .srv-icon{background:rgba(91,108,249,.22);transform:scale(1.05)}
.srv-card h3{font-size:1.05rem;font-weight:700;margin-bottom:10px;position:relative;z-index:1}
.srv-card p{font-size:.83rem;color:var(--fg2);line-height:1.68;font-weight:300;position:relative;z-index:1}
.srv-link{
  display:inline-flex;align-items:center;gap:5px;font-size:.78rem;
  color:var(--accent);font-weight:500;margin-top:18px;
  opacity:0;transform:translateX(-8px);transition:.25s;position:relative;z-index:1;
}
.srv-card:hover .srv-link{opacity:1;transform:translateX(0)}

/* ===== HOME — WHY US ===== */
.why-grid{display:grid;grid-template-columns:1fr 1fr;gap:2px;background:var(--border);border-radius:var(--r3);overflow:hidden}
.why-item{
  padding:40px 36px;background:var(--bg2);transition:.2s;
}
.why-item:hover{background:var(--bg3)}
.why-num{
  font-family:'Syne',sans-serif;font-size:2.5rem;font-weight:800;
  color:transparent;-webkit-text-stroke:1px var(--border2);margin-bottom:16px;
  line-height:1;
}
.why-item h4{font-size:1.05rem;font-weight:700;margin-bottom:10px}
.why-item p{font-size:.85rem;color:var(--fg2);line-height:1.7;font-weight:300}

/* ===== HOME — TESTIMONIALS ===== */
.testimonials-wrap{overflow:hidden}
.testimonials-track{display:flex;gap:20px;transition:transform .5s cubic-bezier(.4,0,.2,1)}
.testi-card{
  min-width:380px;padding:32px;border-radius:var(--r3);
  background:rgba(255,255,255,.04);border:1px solid var(--border2);
  backdrop-filter:blur(10px);flex-shrink:0;
}
.testi-stars{color:var(--amber);font-size:.9rem;margin-bottom:16px;letter-spacing:2px}
.testi-quote{font-size:.92rem;color:var(--fg);line-height:1.75;font-weight:300;margin-bottom:20px;font-style:italic}
.testi-author{display:flex;align-items:center;gap:12px}
.testi-avatar{
  width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;
  font-weight:800;font-size:.85rem;flex-shrink:0;
}
.testi-name{font-size:.88rem;font-weight:600}
.testi-company{font-size:.75rem;color:var(--fg3)}
.testi-controls{display:flex;gap:10px;margin-top:28px}
.testi-btn{
  width:38px;height:38px;border-radius:50%;background:var(--bg3);border:1px solid var(--border);
  color:var(--fg2);font-size:1rem;transition:.2s;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
}
.testi-btn:hover{background:var(--bg4);color:var(--fg)}

/* ===== HOME — CTA ===== */
.cta-banner{
  margin:0 48px 80px;border-radius:var(--r3);padding:72px 60px;
  background:linear-gradient(135deg,rgba(91,108,249,.18) 0%,rgba(139,92,246,.12) 100%);
  border:1px solid rgba(91,108,249,.25);text-align:center;position:relative;overflow:hidden;
}
.cta-banner::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 60% 80% at 50% 100%,rgba(91,108,249,.15),transparent);
}
.cta-banner-content{position:relative;z-index:1}
.cta-banner h2{font-size:clamp(1.8rem,4vw,3rem);font-weight:800;margin-bottom:14px;letter-spacing:-.04em}
.cta-banner p{color:var(--fg2);font-size:1rem;margin-bottom:32px;font-weight:300;line-height:1.7}
.cta-banner-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}

/* ===== SERVICES PAGE ===== */
.services-hero-section{
  padding:80px 48px 60px;border-bottom:1px solid var(--border);
  background:linear-gradient(180deg,rgba(91,108,249,.04) 0%,transparent 100%);
}
.services-layout{display:grid;grid-template-columns:260px 1fr;min-height:70vh}
.srv-sidebar{
  border-right:1px solid var(--border);padding:36px 28px;
  position:sticky;top:68px;max-height:calc(100vh - 68px);overflow-y:auto;align-self:start;
}
.srv-sidebar-title{
  font-size:.68rem;font-weight:700;color:var(--fg3);
  text-transform:uppercase;letter-spacing:.14em;margin-bottom:14px;
}
.srv-nav-item{
  display:flex;align-items:center;justify-content:space-between;
  padding:11px 13px;border-radius:9px;cursor:pointer;margin-bottom:3px;
  transition:.2s;border:1px solid transparent;
}
.srv-nav-item:hover{background:rgba(255,255,255,.05)}
.srv-nav-item.active{background:rgba(91,108,249,.12);border-color:rgba(91,108,249,.2)}
.srv-nav-name{font-size:.85rem;font-weight:500;color:var(--fg2);display:flex;align-items:center;gap:8px}
.srv-nav-item.active .srv-nav-name{color:var(--fg)}
.srv-status{
  font-size:.67rem;padding:3px 9px;border-radius:100px;font-weight:600;
  white-space:nowrap;
}
.s-active{background:rgba(16,217,160,.14);color:var(--green)}
.s-progress{background:rgba(91,108,249,.18);color:var(--accent)}
.s-pending{background:rgba(255,255,255,.07);color:var(--fg3)}
.s-done{background:rgba(16,217,160,.1);color:var(--green)}

/* Progress ring in sidebar */
.sidebar-progress{margin-top:28px;padding-top:24px;border-top:1px solid var(--border)}
.sidebar-progress-label{font-size:.68rem;color:var(--fg3);text-transform:uppercase;letter-spacing:.1em;font-weight:600;margin-bottom:14px}
.overall-bar{height:5px;background:rgba(255,255,255,.07);border-radius:100px;overflow:hidden;margin-bottom:8px}
.overall-fill{height:100%;background:linear-gradient(90deg,var(--green),var(--accent));border-radius:100px;width:35%;transition:width 1.5s ease}
.overall-pct{font-size:.78rem;color:var(--fg2);font-weight:500}

/* Service detail */
.srv-detail-panel{padding:44px 48px}
.srv-detail{display:none}
.srv-detail.active{display:block;animation:pageIn .35s ease}
.srv-detail-icon{
  width:64px;height:64px;border-radius:16px;font-size:2rem;
  display:flex;align-items:center;justify-content:center;
  background:rgba(91,108,249,.12);border:1px solid rgba(91,108,249,.22);margin-bottom:24px;
}
.srv-detail h2{font-size:2.2rem;font-weight:800;letter-spacing:-.04em;margin-bottom:14px}
.srv-detail-desc{color:var(--fg2);font-size:.97rem;line-height:1.78;font-weight:300;max-width:620px;margin-bottom:36px}

.deliverables-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-bottom:36px}
.deliverable{
  padding:20px 22px;border-radius:var(--r2);background:var(--bg2);
  border:1px solid var(--border);transition:.2s;
}
.deliverable:hover{border-color:var(--border2);background:var(--bg3)}
.deliverable-icon{font-size:1.2rem;margin-bottom:10px}
.deliverable h4{font-size:.88rem;font-weight:600;margin-bottom:5px}
.deliverable p{font-size:.78rem;color:var(--fg3);line-height:1.6}

/* Progress tracker per service */
.srv-progress-box{
  padding:28px 30px;background:var(--bg2);border-radius:var(--r3);
  border:1px solid var(--border);margin-bottom:28px;
}
.srv-progress-box-title{
  font-size:.85rem;font-weight:700;margin-bottom:20px;
  display:flex;align-items:center;justify-content:space-between;
}
.srv-progress-box-title span{font-size:.78rem;color:var(--fg3);font-weight:400}
.progress-row{margin-bottom:14px}
.progress-row:last-child{margin-bottom:0}
.pr-label{display:flex;justify-content:space-between;margin-bottom:6px}
.pr-name{font-size:.8rem;color:var(--fg2)}
.pr-pct{font-size:.8rem;color:var(--accent);font-weight:600}
.pr-track{height:5px;background:rgba(255,255,255,.07);border-radius:100px;overflow:hidden}
.pr-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:100px;transition:width 1.2s ease .1s}

/* Time estimate */
.srv-time-tags{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}
.time-tag{
  display:flex;align-items:center;gap:6px;font-size:.78rem;
  padding:7px 14px;border-radius:100px;background:var(--bg3);
  border:1px solid var(--border);color:var(--fg2);
}

/* ===== WORK PAGE ===== */
.work-hero{padding:80px 48px 60px;border-bottom:1px solid var(--border)}
.work-filters{display:flex;gap:8px;padding:24px 48px;border-bottom:1px solid var(--border);flex-wrap:wrap}
.filter-btn{
  padding:7px 16px;border-radius:100px;background:transparent;
  border:1px solid var(--border);color:var(--fg2);font-size:.8rem;
  font-weight:500;cursor:pointer;transition:.2s;font-family:'DM Sans',sans-serif;
}
.filter-btn:hover,.filter-btn.active{background:rgba(91,108,249,.15);border-color:rgba(91,108,249,.3);color:var(--fg)}
.work-grid-main{display:grid;grid-template-columns:repeat(2,1fr);gap:2px;background:var(--border)}
.work-card-main{
  background:var(--bg2);overflow:hidden;cursor:pointer;
  transition:all .3s;position:relative;
}
.work-card-main.featured{grid-column:span 2}
.work-card-main:hover{background:var(--bg3)}
.work-thumb{
  width:100%;aspect-ratio:16/9;position:relative;overflow:hidden;
  display:flex;align-items:center;justify-content:center;
}
.work-card-main.featured .work-thumb{aspect-ratio:21/9}
.work-thumb-bg{position:absolute;inset:0;transition:transform .6s ease}
.work-card-main:hover .work-thumb-bg{transform:scale(1.04)}
.work-thumb-text{position:relative;z-index:1;text-align:center;padding:20px}
.work-thumb-text h3{font-size:1.8rem;font-weight:800;color:#fff;margin-bottom:6px;text-shadow:0 2px 20px rgba(0,0,0,.5)}
.work-card-main.featured .work-thumb-text h3{font-size:2.6rem}
.work-thumb-text p{font-size:.85rem;color:rgba(255,255,255,.65)}
.work-hover-overlay{
  position:absolute;inset:0;background:rgba(7,7,10,.8);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  opacity:0;transition:.3s;z-index:2;
}
.work-card-main:hover .work-hover-overlay{opacity:1}
.work-hover-btn{
  padding:11px 24px;border-radius:9px;background:var(--accent);color:#fff;
  font-size:.875rem;font-weight:500;
}
.work-info-bar{
  padding:22px 28px;border-top:1px solid var(--border);
  display:flex;align-items:flex-start;justify-content:space-between;gap:20px;
  flex-wrap:wrap;
}
.work-meta-left h4{font-size:1rem;font-weight:700;margin-bottom:6px}
.work-tags{display:flex;gap:7px;flex-wrap:wrap}
.tag{font-size:.7rem;padding:3px 10px;border-radius:100px;background:rgba(255,255,255,.07);color:var(--fg2);font-weight:500}
.work-metrics{display:flex;gap:22px}
.metric{text-align:right}
.metric-val{font-family:'Syne',sans-serif;font-size:1.5rem;font-weight:800;color:var(--green)}
